# Copy to .env and fill in, or let `make up` create .env with fresh random secrets.
# Placeholder values only; never commit .env. Every `change-me` is replaced by a new
# random value (`change-me-hex32` by 64 hex characters).
# Each service reads only its own block (D46); compose passes each container only its own.

# --- Shared (every service) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/servewell
OPA_URL=http://localhost:8181
LITELLM_BASE_URL=http://localhost:4000
LOG_DIR=logs
CLOCK_MODE=live
EVAL_MODE=false

# --- S3 endpoint (ingest, kb-index, api, eval) ---
S3_ENDPOINT_URL=http://localhost:8333

# --- ingest ---
DATABASE_URL_INGEST=postgresql://ingest_rw:change-me@localhost:5432/servewell
S3_ACCESS_KEY_INGEST=change-me
S3_SECRET_KEY_INGEST=change-me
# Source dataset folder (read-only), relative to the repo root.
DATASET_DIR=../../references/assignment/dataset

# --- intake ---
DATABASE_URL_INTAKE=postgresql://intake_rw:change-me@localhost:5432/servewell
MODEL_MODERATION=moderation
MODERATION_MAX_CALLS=10

# --- it-data ---
DATABASE_URL_IT_DATA=postgresql://it_data_ro:change-me@localhost:5432/servewell

# --- knowledge ---
DATABASE_URL_KNOWLEDGE=postgresql://knowledge_ro:change-me@localhost:5432/servewell
MODEL_EMBED=embed
EMBED_DIM=768

# --- kb-index (make index, S6) ---
DATABASE_URL_KB_INDEX=postgresql://kb_index_rw:change-me@localhost:5432/servewell
S3_ACCESS_KEY_KB_INDEX=change-me
S3_SECRET_KEY_KB_INDEX=change-me

# --- itsm-actions ---
DATABASE_URL_ITSM=postgresql://itsm_rw:change-me@localhost:5432/servewell
# A35: reversible actions become autonomous after this many approved, successful runs
# in a row. 1 for the POC demo only; the client's L2 team sets it before real use.
ACTION_AUTONOMY_RUNS=1
APPROVAL_TTL_MIN=15

# --- agent ---
DATABASE_URL_AGENT=postgresql://agent_actor:change-me@localhost:5432/servewell
MODEL_AGENT=agent
LLM_MAX_CALLS=15
TRIAGE_MAX_TOOL_CALLS=6
TOKEN_BUDGET_PER_TICKET=50000
KEYCLOAK_SECRET_AGENT_READER=change-me
KEYCLOAK_SECRET_AGENT_ACTOR=change-me

# --- api ---
DATABASE_URL_API=postgresql://api_rw:change-me@localhost:5432/servewell
S3_ACCESS_KEY_API=change-me
S3_SECRET_KEY_API=change-me

# --- eval ---
DATABASE_URL_EVAL=postgresql://eval_ro:change-me@localhost:5432/servewell
S3_ACCESS_KEY_EVAL=change-me
S3_SECRET_KEY_EVAL=change-me
MODEL_JUDGE=judge
MODEL_SIMULATOR=simulator
KEYCLOAK_SECRET_EVAL_RUNNER=change-me

# --- checker (independent safety checker, D42) ---
DATABASE_URL_CHECKER=postgresql://checker_ro:change-me@localhost:5432/servewell

# ===== Platform (compose and `make up` only; no app service reads these) =====
# Colima VM memory in GB (A30). `make up` refuses to start on any other size.
COLIMA_MEMORY=8
# Refuse a non-Ollama model in compose/litellm/config.yaml unless true (Codex P1).
ALLOW_EXTERNAL_MODELS=false
# `make up LEAN=1` skips Prometheus and Grafana when memory is short (X3).
COMPOSE_PROFILES=observability

POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Master-realm admin service client (client credentials) for tests and tooling.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# Mock-user client secrets are HMAC-SHA256(this key, client_id); see platform/mock_secrets.py.
MOCK_CLIENT_SECRET_KEY=change-me
LITELLM_MASTER_KEY=sk-change-me

LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me-hex32
LANGFUSE_ADMIN_PASSWORD=change-me
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_HOST=http://localhost:3000
S3_ACCESS_KEY_LANGFUSE=change-me
S3_SECRET_KEY_LANGFUSE=change-me
CLICKHOUSE_PASSWORD=change-me
VALKEY_PASSWORD=change-me

GRAFANA_ADMIN_PASSWORD=change-me
