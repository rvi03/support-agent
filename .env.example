# Copy to .env and fill in. Placeholder values only; never commit .env.
# Each service reads only its own block (D46); compose passes each container only its own.

# --- Shared (every service) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/servewell
OPA_URL=http://localhost:8181
LITELLM_BASE_URL=http://localhost:4000
LOG_DIR=logs
CLOCK_MODE=live
EVAL_MODE=false

# --- S3 endpoint (ingest, api, eval) ---
S3_ENDPOINT_URL=http://localhost:8333

# --- ingest ---
DATABASE_URL_INGEST=postgresql://ingest:change-me@localhost:5432/servewell
S3_ACCESS_KEY_INGEST=change-me
S3_SECRET_KEY_INGEST=change-me

# --- intake ---
DATABASE_URL_INTAKE=postgresql://intake:change-me@localhost:5432/servewell
MODEL_MODERATION=granite3-guardian:2b
MODERATION_MAX_CALLS=10

# --- it-data ---
DATABASE_URL_IT_DATA=postgresql://it_data:change-me@localhost:5432/servewell

# --- knowledge ---
DATABASE_URL_KNOWLEDGE=postgresql://knowledge:change-me@localhost:5432/servewell
MODEL_EMBED=nomic-embed-text
EMBED_DIM=768

# --- itsm-actions ---
DATABASE_URL_ITSM=postgresql://itsm:change-me@localhost:5432/servewell
# A35: reversible actions become autonomous after this many approved, successful runs
# in a row. 1 for the POC demo only; the client's L2 team sets it before real use.
ACTION_AUTONOMY_RUNS=1
APPROVAL_TTL_MIN=15

# --- agent ---
DATABASE_URL_AGENT=postgresql://agent:change-me@localhost:5432/servewell
MODEL_AGENT=qwen3:8b
LLM_MAX_CALLS=15
TRIAGE_MAX_TOOL_CALLS=6
TOKEN_BUDGET_PER_TICKET=50000

# --- api ---
DATABASE_URL_API=postgresql://api:change-me@localhost:5432/servewell
S3_ACCESS_KEY_API=change-me
S3_SECRET_KEY_API=change-me

# --- eval ---
DATABASE_URL_EVAL=postgresql://eval:change-me@localhost:5432/servewell
S3_ACCESS_KEY_EVAL=change-me
S3_SECRET_KEY_EVAL=change-me
MODEL_JUDGE=phi4
MODEL_SIMULATOR=granite3.3:8b

# --- checker (independent safety checker, D42) ---
DATABASE_URL_CHECKER=postgresql://checker:change-me@localhost:5432/servewell
