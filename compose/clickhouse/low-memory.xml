<!-- ClickHouse on one laptop (S10): Langfuse's trace store ran out of its 1.35 GiB
     server limit and dropped every trace write. ClickHouse's own system logs and
     default caches are sized for a server; turn the logs off and shrink the caches. -->
<clickhouse>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <blob_storage_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <zookeeper_log remove="1"/>
    <crash_log remove="1"/>
</clickhouse>
